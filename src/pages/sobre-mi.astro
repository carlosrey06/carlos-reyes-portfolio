---
import Layout from '../layouts/Layout.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Experience from '../components/Experience.astro';
import Method from '../components/Method.astro';
import { contact } from '../data/portfolio';
---
<Layout title="Sobre mí — Carlos Reyes" description="Conoce la trayectoria de Carlos Reyes: desarrollo Full Stack, ingeniería en sistemas, infraestructura y soporte TI.">
  <SiteNavigation />
  <main id="main-content">
    <section class="about-intro section-shell" aria-labelledby="about-title">
      <p class="eyebrow">CARLOS EDUARDO REYES CRUZ / PERFIL</p>
      <h1 id="about-title">Construir con <em>criterio.</em><br />Mantener con rigor.</h1>
      <div class="about-grid">
        <p class="about-lead">Soy Carlos Reyes, desarrollador Full Stack e Ingeniero en Sistemas Computacionales. Trabajo entre interfaces, lógica de negocio, datos e infraestructura.</p>
        <div><p>Mi experiencia combina la construcción de aplicaciones web con despliegues y operación de servidores. También he trabajado cerca de usuarios: diagnosticando incidencias, entendiendo procesos y resolviendo necesidades concretas de equipos y empresas.</p><p>Esa perspectiva me ayuda a diseñar soluciones que sean claras para quien las usa y mantenibles para quien debe operarlas.</p><a href={contact.cv} download>Descargar CV <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <Experience />
    <Method />
    <section class="about-close section-shell"><p>¿Hablamos de tu próximo proyecto?</p><a href={`mailto:${contact.email}`}>Escríbeme por correo <span aria-hidden="true">↗</span></a></section>
  </main>
  <SiteFooter />
</Layout>
<style>
.about-intro { padding-block:clamp(80px,12vw,170px) clamp(96px,14vw,180px); }
.eyebrow { margin:0 0 40px; color:var(--color-cyan); font-size:.72rem; font-weight:700; letter-spacing:.12em; }
h1 { max-width:1200px; margin:0; font:600 clamp(2.7rem,8vw,8rem)/.99 var(--font-display); text-transform:uppercase; }
h1 em { font:italic 400 1.08em var(--font-editorial); text-transform:none; }
.about-grid { display:grid; gap:24px; max-width:1100px; margin-top:clamp(64px,9vw,128px); }
.about-grid p { color:var(--color-muted); line-height:1.7; }
.about-grid .about-lead { margin:0; color:var(--color-text); font:400 clamp(1.5rem,3vw,2.8rem)/1.22 var(--font-editorial); }
.about-grid div p:first-child { margin-top:0; }
.about-grid a,.about-close a { display:inline-flex; min-height:48px; align-items:center; gap:24px; color:var(--color-text); font-weight:600; text-decoration:none; border-bottom:1px solid var(--color-cyan); }
.about-grid a:hover,.about-close a:hover { color:var(--color-cyan); }
.about-close { padding-block:110px; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:24px; }
.about-close p { margin:0; font:italic 400 clamp(2rem,4vw,3.5rem) var(--font-editorial); }
@media(min-width:768px) { .about-grid { grid-template-columns:1.2fr 1fr; gap:64px; } }
</style>
