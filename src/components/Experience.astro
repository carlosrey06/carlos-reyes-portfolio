---
import { experience } from '../data/portfolio';
---

<section id="experience" class="experience section-shell" aria-labelledby="experience-title">
  <header class="experience-heading">
    <h2 id="experience-title">Experiencia <em>real.</em><br />Visión integral.</h2>
    <p>Desarrollo, sistemas y operación técnica en entornos profesionales.</p>
  </header>

  <ol class="experience-list">
    {experience.map((item) => (
      <li class="experience-item">
        <p class="experience-period">{item.dates}</p>
        <div class="experience-position">
          <h3>{item.role}</h3>
          <p class="experience-company">{item.company}</p>
        </div>
        <div class="experience-details">
          <p class="experience-summary">{item.summary}</p>
          <p class="experience-context">{item.context}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience {
    padding-block: clamp(88px, 13vw, 160px);
  }

  .experience-heading {
    display: grid;
    gap: 20px;
    margin-bottom: 64px;
  }

  .experience-heading h2 {
    margin: 0;
    font: 600 clamp(2.2rem, 7vw, 6rem) / 1.02 var(--font-display);
    letter-spacing: 0.015em;
    text-transform: uppercase;
  }

  .experience-heading em {
    color: var(--color-text);
    font: italic 400 1.08em var(--font-editorial);
    text-transform: none;
  }

  .experience-heading p {
    max-width: 32rem;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .experience-list {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .experience-item {
    display: grid;
    grid-template-areas:
      'period'
      'position'
      'details';
    min-width: 0;
    padding: 32px 0;
    border-top: 1px solid var(--color-border);
  }

  .experience-period {
    grid-area: period;
    margin: 0 0 14px;
    color: var(--color-muted);
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .experience-position {
    grid-area: position;
    min-width: 0;
  }

  .experience-position h3 {
    margin: 0 0 6px;
    font: 600 clamp(1.3rem, 3vw, 2.15rem) / 1.2 var(--font-ui);
  }

  .experience-company {
    margin: 0;
    color: var(--color-text);
    font: italic 400 1.5rem var(--font-editorial);
  }

  .experience-details {
    grid-area: details;
    min-width: 0;
    margin-top: 20px;
  }

  .experience-summary {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .experience-context {
    margin: 18px 0 0;
    color: var(--color-cyan);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .experience-item {
      grid-template-columns: 150px minmax(0, 1fr);
      grid-template-areas:
        'period position'
        '. details';
      column-gap: 28px;
      padding: 40px 0;
    }

    .experience-period {
      margin: 0;
    }

    .experience-details {
      margin-top: 18px;
    }
  }

  @media (min-width: 1200px) {
    .experience-item {
      grid-template-columns: minmax(120px, 0.35fr) minmax(280px, 1.15fr) minmax(0, 1fr);
      grid-template-areas: 'period position details';
      column-gap: clamp(28px, 3vw, 48px);
    }

    .experience-details {
      margin-top: 0;
    }
  }
</style>
