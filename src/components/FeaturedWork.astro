---
import FeaturedProject from './FeaturedProject.astro';
---

<section class="featured-work" aria-labelledby="featured-work-title">
	<div class="featured-work__inner">
		<header class="featured-work__header">
			<p class="featured-work__eyebrow">01 / PROYECTOS</p>
			<h2 id="featured-work-title">Proyectos destacados</h2>
		</header>

		<div class="featured-work__list">
			<FeaturedProject
				index="01"
				name="Frío Puro"
				description="Sitio corporativo y plataforma de contenido desarrollada de extremo a extremo y llevada a producción."
				status="EN PRODUCCIÓN"
				contribution="Desarrollo integral"
				technologies={['Astro', 'TypeScript', 'MySQL', 'Drizzle ORM', 'Docker', 'Traefik']}
				domain="friopuro.com.mx"
				url="https://friopuro.com.mx"
			/>

			<FeaturedProject
				index="02"
				name="Sellers"
				description="Plataforma B2B orientada a sellers, proveedores y marcas interesadas en comercializar productos en México."
				status="EN PRODUCCIÓN"
				contribution="Desarrollo colaborativo"
				technologies={['Astro', 'TypeScript', 'SSR', 'MySQL', 'Docker', 'Traefik']}
				domain="sellers.importacionesamexico.com.mx"
				url="https://sellers.importacionesamexico.com.mx"
			/>

			<FeaturedProject
				index="03"
				name="V.A.U.L.T."
				subtitle="Virtual Asset & Unified Logistics Tracker"
				description="Sistema multiempresa para inventario, administración y trazabilidad de activos."
				status="EN DESARROLLO"
				contribution="Desarrollo integral"
				technologies={['React', 'TypeScript', 'NestJS', 'MySQL', 'Drizzle ORM', 'Docker']}
			/>

			<FeaturedProject
				index="04"
				name="ARCH"
				projectType="Proyecto personal"
				description="Plataforma personal de gestión financiera enfocada en organizar cuentas, movimientos y obligaciones."
				status="EN DESARROLLO"
				contribution="Desarrollo integral"
				technologies={['Next.js', 'TypeScript', 'MySQL', 'Drizzle ORM', 'Better Auth', 'Docker']}
			/>
		</div>
	</div>
</section>

<style>
	.featured-work {
		position: relative;
		padding: clamp(56px, 10vw, 72px) 0 clamp(80px, 12vw, 144px);
		background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--color-surface) 24%, transparent) 30%, transparent 100%);
	}

	.featured-work__inner {
		box-sizing: border-box;
		width: min(100%, var(--content-width));
		margin: 0 auto;
		padding-inline: var(--page-padding);
	}

	.featured-work__header {
		max-width: 42rem;
		margin-bottom: clamp(48px, 8vw, 88px);
	}

	.featured-work__eyebrow {
		margin: 0 0 18px;
		color: var(--color-cyan);
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.featured-work h2 {
		max-width: 34rem;
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 10vw, 5rem);
		font-weight: 600;
		letter-spacing: 0.035em;
		line-height: 0.98;
	}

	.featured-work__list {
		border-bottom: 1px solid var(--color-border);
	}

	@media (min-width: 768px) {
		.featured-work {
			padding-top: clamp(112px, 12vw, 176px);
		}

		.featured-work__header {
			margin-bottom: clamp(32px, 4vw, 40px);
		}

		.featured-work h2 {
			font-size: clamp(2.2rem, 7.5vw, 3.75rem);
		}
	}
</style>
