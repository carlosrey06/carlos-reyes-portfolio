---
import FeaturedProject from './FeaturedProject.astro';
---

<section class="featured-work" aria-labelledby="featured-work-title">
	<div class="featured-work__inner">
		<header class="featured-work__header">
			<p class="featured-work__eyebrow">01 / PROYECTOS</p>
			<h2 id="featured-work-title">Proyectos destacados</h2>
		</header>

		<FeaturedProject
			index="01"
			nameLines={['FRÍO', 'PURO']}
			description="Sitio corporativo y plataforma de contenido desarrollada de extremo a extremo y llevada a producción."
			status="PRODUCTION"
			contribution="Desarrollo integral"
			stack={['Astro', 'TypeScript', 'MySQL', 'Drizzle ORM', 'Docker', 'Traefik']}
			domain="friopuro.com.mx"
			href="https://friopuro.com.mx"
		/>

		<FeaturedProject
			index="02"
			nameLines={['SELLERS']}
			description="Plataforma B2B orientada a sellers, proveedores y marcas interesadas en comercializar productos en México."
			status="PRODUCTION"
			contribution="Desarrollo colaborativo"
			stack={['Astro', 'TypeScript', 'SSR', 'MySQL', 'Docker', 'Traefik']}
			domain="sellers.importacionesamexico.com.mx"
			href="https://sellers.importacionesamexico.com.mx"
			variant="sellers"
		/>
	</div>
</section>

<style>
	.featured-work {
		position: relative;
		padding: clamp(56px, 10vw, 72px) 0 120px;
		background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--color-surface) 36%, transparent) 18%, transparent 100%);
	}

	.featured-work__inner {
		box-sizing: border-box;
		width: min(100%, var(--content-width));
		margin: 0 auto;
		padding-inline: var(--page-padding);
	}

	.featured-work__header {
		max-width: 42rem;
		margin-bottom: clamp(48px, 8vw, 96px);
	}

	.featured-work__eyebrow {
		margin: 0 0 18px;
		color: var(--color-cyan);
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.featured-work h2 {
		max-width: 34rem;
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 10vw, 5rem);
		font-weight: 600;
		letter-spacing: 0.035em;
		line-height: 0.98;
	}

	@media (min-width: 768px) {
		.featured-work {
			padding-top: clamp(112px, 12vw, 176px);
		}

		.featured-work h2 {
			font-size: clamp(2.2rem, 8.5vw, 4.25rem);
		}
	}
</style>
