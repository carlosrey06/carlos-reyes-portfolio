---
import FeaturedProject from './FeaturedProject.astro';
import { featuredProjects } from '../data/portfolio';
---

<section id="projects" class="featured-work" aria-labelledby="featured-work-title">
	<div class="featured-work__inner">
		<header class="featured-work__header">
			<h2 id="featured-work-title">Proyectos destacados</h2>
		</header>

		<div class="featured-work__list">
			{featuredProjects.map((project, index) => <FeaturedProject
				name={project.name}
				projectType={project.type}
				description={project.description}
				status={project.status}
				contribution={'contribution' in project ? project.contribution : undefined}
				technologies={'technologies' in project ? [...project.technologies] : []}
				url={'url' in project ? project.url : undefined}
				domain={'domain' in project ? project.domain : undefined}
				image={project.image}
				imageSmall={project.imageSmall}
				imageAlt={project.imageAlt}
				stackIndex={index}
			/>)}
		</div>
	</div>
</section>

<style>
	.featured-work {
		position: relative;
		padding: clamp(64px, 10vw, 80px) 0 clamp(80px, 12vw, 144px);
		background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--color-surface) 24%, transparent) 30%, transparent 100%);
	}

	.featured-work__inner {
		box-sizing: border-box;
		width: min(100%, var(--content-width));
		margin: 0 auto;
		padding-inline: var(--page-padding);
	}

	.featured-work__header {
		max-width: 42rem;
		margin-bottom: clamp(48px, 8vw, 88px);
	}

	.featured-work h2 {
		max-width: 34rem;
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 10vw, 5rem);
		font-weight: 600;
		letter-spacing: 0.035em;
		line-height: 0.98;
	}

	.featured-work__list {
		border-bottom: 1px solid var(--color-border);
	}

	@media (min-width: 768px) {
		.featured-work {
			padding-top: clamp(104px, 10vw, 136px);
		}

		.featured-work__header {
			margin-bottom: clamp(32px, 4vw, 40px);
		}

		.featured-work h2 {
			font-size: clamp(2.2rem, 7.5vw, 3.75rem);
		}
	}
</style>
