---
import { contact } from '../data/portfolio';
import HeroCodeTerminal from './HeroCodeTerminal.astro';
---
<section id="home" class="hero" aria-labelledby="hero-name">
	<div class="hero__inner">
		<p class="hero__title">
			<span>FULL STACK DEVELOPER</span>
			<span>&amp; SYSTEMS ENGINEER</span>
		</p>

		<h1 id="hero-name" class="hero__name">
			<span>CARLOS</span>
			<span>REYES</span>
		</h1>

		<p class="hero__description">
			Desarrollo aplicaciones web completas y la infraestructura necesaria para llevarlas a producción de
			forma segura y mantenible.
		</p>

		<div class="hero__actions" aria-label="Acciones principales">
			<a class="hero__cta hero__cta--primary" href="#projects">
				Ver proyectos
			</a>

			<a class="hero__cta hero__cta--secondary" href={contact.cv} download>
				Descargar CV
			</a>
		</div>
	</div>

	<HeroCodeTerminal />
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		min-height: auto;
		overflow: hidden;
		flex-direction: column;
		align-items: stretch;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		width: min(100%, var(--content-width));
		margin: 0 auto;
		padding: 48px var(--page-padding) 32px;
	}

	.hero__title {
		max-width: 19rem;
		margin: 0 0 28px;
		color: var(--color-muted);
		font-family: var(--font-ui);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		line-height: 1.45;
		text-transform: uppercase;
		animation: hero-rise 500ms ease-out 100ms both;
	}

	.hero__title span {
		display: block;
	}

	.hero__name {
		display: flex;
		flex-direction: column;
		gap: 0;
		max-width: 100%;
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 17vw, 6rem);
		font-weight: 700;
		letter-spacing: 0.045em;
		line-height: 0.93;
		text-wrap: balance;
		animation: hero-name-reveal 1100ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__name span {
		display: block;
	}

	.hero__description {
		max-width: 36rem;
		margin: 32px 0 0;
		color: var(--color-muted);
		font-family: var(--font-ui);
		font-size: clamp(1rem, 2.8vw, 1.125rem);
		line-height: 1.65;
		animation: hero-rise 650ms ease-out 250ms both;
	}

	.hero__actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 12px;
		max-width: 22rem;
		margin-top: 36px;
		animation: hero-rise 650ms ease-out 350ms both;
	}

	.hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 14px 20px;
		border: 1px solid transparent;
		border-radius: 8px;
		font-family: var(--font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.hero__cta:disabled {
		cursor: default;
		opacity: 1;
	}

	.hero__cta--primary {
		background: var(--color-blue);
		color: var(--color-text);
	}

	.hero__cta--primary:hover {
		background: color-mix(in srgb, var(--color-blue) 84%, var(--color-cyan));
	}

	.hero__cta--secondary {
		align-self: center;
		min-height: 48px;
		padding-inline: 12px;
		border: 0;
		border-bottom: 1px solid var(--color-border-strong);
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
	}

	@keyframes hero-name-reveal {
		from {
			opacity: 0;
			letter-spacing: 0.13em;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			letter-spacing: 0.045em;
			transform: translateY(0);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (min-width: 640px) and (max-width: 767px) {
		.hero__inner {
			padding-top: 56px;
		}

		.hero__name {
			font-size: clamp(4.2rem, 13vw, 5.8rem);
		}
	}

	@media (min-width: 768px) and (max-width: 1023px) {
		.hero {
			min-height: auto;
		}

		.hero__inner {
			display: grid;
			grid-template-columns: repeat(8, minmax(0, 1fr));
			column-gap: 20px;
			align-content: center;
			padding-top: 56px;
			padding-bottom: 36px;
		}

		.hero__title {
			grid-column: 1 / span 6;
			max-width: 36rem;
		}

		.hero__name,
		.hero__description,
		.hero__actions {
			grid-column: 1 / span 6;
		}

		.hero__name {
			font-size: clamp(6.25rem, 12vw, 8.75rem);
			letter-spacing: 0.055em;
		}

		.hero__name span {
			display: block;
		}

		.hero__actions {
			flex-direction: row;
			align-items: center;
			max-width: none;
		}

		.hero__description {
			max-width: 34rem;
		}


		.hero__cta {
			min-width: 10rem;
		}
	}

	@media (min-width: 1024px) {
		.hero {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: clamp(24px, 2vw, 32px);
			align-items: stretch;
			height: calc(100svh - 64px);
			min-height: 640px;
			padding-inline: max(var(--page-padding), calc((100vw - var(--content-width)) / 2));
		}

		.hero__inner {
			display: flex;
			width: 100%;
			margin: 0;
			padding-block: 64px;
			padding-inline: 0;
			align-self: stretch;
		}

		.hero__title {
			font-size: 0.82rem;
		}

		.hero__name {
			font-size: clamp(5rem, 8vw, 9rem);
			letter-spacing: 0.055em;
		}

		.hero__name span {
			display: block;
		}

		.hero__actions {
			flex-direction: row;
			align-items: center;
			max-width: none;
		}

		.hero__description {
			max-width: 36rem;
		}

		.hero__cta {
			min-width: 10rem;
		}
	}

	@media (max-width: 639px) {
		.hero__actions {
			width: 100%;
			max-width: none;
			align-items: center;
		}

		.hero__cta--primary {
			display: inline-flex;
			width: 100%;
			align-items: center;
			justify-content: center;
			padding-inline: 20px;
			text-align: center;
		}

		.hero__cta--secondary {
			display: inline-flex;
			width: fit-content;
			align-items: center;
			justify-content: center;
			margin-inline: auto;
			text-align: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__title,
		.hero__name,
		.hero__description,
		.hero__actions {
			animation: none;
		}
	}
</style>
