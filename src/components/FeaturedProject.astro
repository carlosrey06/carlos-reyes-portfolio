---
interface Props {
	index: string;
	name: string;
	subtitle?: string;
	projectType?: string;
	description: string;
	status: string;
	contribution: string;
	technologies: string[];
	url?: string;
	domain?: string;
}

const { index, name, subtitle, projectType, description, status, contribution, technologies, url, domain } = Astro.props;
---

<article class="featured-project">
	<div class="featured-project__marker">
		<span class="featured-project__index">{index}</span>
		<span class="featured-project__status">{status}</span>
	</div>

	<div class="featured-project__identity">
		<h3 class="featured-project__name">{name}</h3>
		{subtitle && <p class="featured-project__subtitle">{subtitle}</p>}
		{projectType && <p class="featured-project__type">{projectType}</p>}
	</div>

	<div class="featured-project__summary">
		<p class="featured-project__description">{description}</p>
		<p class="featured-project__contribution">
			<span>Participación</span>
			<strong>{contribution}</strong>
		</p>
	</div>

	<div class="featured-project__details">
		<p class="featured-project__details-label">Tecnologías</p>
		<ul class="featured-project__stack" aria-label={`Tecnologías principales de ${name}`}>
			{technologies.map((technology) => <li>{technology}</li>)}
		</ul>

		{url && (
			<a
				class="featured-project__link"
				href={url}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Visitar el proyecto ${name} (se abre en una pestaña nueva)`}
			>
				<span class="featured-project__link-label">
					Visitar proyecto <span class="featured-project__arrow" aria-hidden="true">↗</span>
				</span>
				{domain && <span class="featured-project__domain">{domain}</span>}
			</a>
		)}
	</div>
</article>

<style>
	.featured-project {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 28px 16px;
		padding-block: clamp(48px, 14vw, 64px);
		border-top: 1px solid var(--color-border);
	}

	.featured-project::before {
		position: absolute;
		top: -1px;
		left: 0;
		width: 40px;
		height: 1px;
		background: var(--color-cyan);
		content: '';
	}

	.featured-project__marker,
	.featured-project__identity,
	.featured-project__summary,
	.featured-project__details {
		grid-column: 1 / -1;
	}

	.featured-project__marker {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.featured-project__index,
	.featured-project__status,
	.featured-project__type,
	.featured-project__details-label,
	.featured-project__contribution span,
	.featured-project__stack {
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.featured-project__index {
		color: var(--color-cyan);
		font-weight: 700;
	}

	.featured-project__status {
		color: var(--color-muted);
	}

	.featured-project__name {
		max-width: 100%;
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 13vw, 3.6rem);
		font-weight: 600;
		letter-spacing: 0.035em;
		line-height: 0.96;
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}

	.featured-project__subtitle,
	.featured-project__type {
		max-width: 28rem;
		margin: 14px 0 0;
		color: var(--color-muted);
	}

	.featured-project__subtitle {
		font-family: var(--font-ui);
		font-size: 0.82rem;
		letter-spacing: 0.035em;
		line-height: 1.55;
	}

	.featured-project__type {
		font-weight: 600;
	}

	.featured-project__description {
		max-width: 36rem;
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-ui);
		font-size: clamp(1rem, 2vw, 1.08rem);
		line-height: 1.7;
	}

	.featured-project__contribution {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 24px 0 0;
	}

	.featured-project__contribution span,
	.featured-project__details-label {
		color: var(--color-muted);
	}

	.featured-project__contribution strong {
		color: var(--color-text);
		font-family: var(--font-ui);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.5;
	}

	.featured-project__details-label {
		margin: 0 0 10px;
	}

	.featured-project__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 0;
		margin: 0;
		padding: 0;
		color: var(--color-text);
		list-style: none;
	}

	.featured-project__stack li:not(:last-child)::after {
		margin-inline: 8px;
		color: var(--color-cyan);
		content: '/';
	}

	.featured-project__link {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 7px;
		max-width: 100%;
		margin-top: 26px;
		color: var(--color-text);
		font-family: var(--font-ui);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.35;
		text-decoration: none;
	}

	.featured-project__link-label {
		padding-bottom: 5px;
		border-bottom: 1px solid var(--color-cyan);
		transition:
			border-color 180ms ease,
			color 180ms ease;
	}

	.featured-project__arrow {
		display: inline-block;
		color: var(--color-cyan);
		transition: transform 180ms ease;
	}

	.featured-project__domain {
		max-width: 100%;
		color: var(--color-muted);
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0.025em;
		overflow-wrap: anywhere;
	}

	.featured-project__link:focus-visible {
		border-radius: 1px;
	}

	@media (hover: hover) and (pointer: fine) {
		.featured-project__link:hover .featured-project__link-label {
			border-color: var(--color-text);
			color: var(--color-cyan);
		}

		.featured-project__link:hover .featured-project__arrow {
			transform: translate(2px, -2px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.featured-project::before {
			animation: project-rule-reveal 700ms ease-out both;
		}
	}

	@keyframes project-rule-reveal {
		from {
			transform: scaleX(0);
			transform-origin: left;
		}

		to {
			transform: scaleX(1);
			transform-origin: left;
		}
	}

	@media (min-width: 768px) {
		.featured-project {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			gap: 36px clamp(18px, 2vw, 28px);
			padding-block: clamp(56px, 8vw, 80px);
		}

		.featured-project__marker {
			grid-column: 1 / span 2;
			align-items: flex-start;
			justify-content: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		.featured-project__identity {
			grid-column: 3 / span 5;
		}

		.featured-project__summary {
			grid-column: 8 / span 5;
		}

		.featured-project__details {
			grid-column: 3 / span 10;
		}

		.featured-project__name {
			font-size: clamp(2.75rem, 4.3vw, 3.3rem);
			overflow-wrap: normal;
		}
	}

	@media (min-width: 1100px) {
		.featured-project {
			column-gap: clamp(22px, 2vw, 32px);
		}

		.featured-project__identity {
			grid-column: 3 / span 3;
		}

		.featured-project__summary {
			grid-column: 6 / span 4;
		}

		.featured-project__details {
			grid-column: 10 / span 3;
		}

		.featured-project__name {
			font-size: clamp(2.75rem, 4vw, 3.3rem);
		}

		.featured-project__description {
			font-size: 1rem;
		}
	}
</style>
