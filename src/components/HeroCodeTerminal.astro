		'<span class="terminal__kw">await</span> server.listen({ host: <span class="terminal__string">\'0.0.0.0\'</span>, port });',
		'<span class="terminal__ok">[node]</span> event loop ready · 4 active handles · 38 MB',
		'<span class="terminal__comment">// Una fila por entrada · buffer acotado y continuo.</span>',
	],
	compact: [
		'<span class="terminal__kw">type</span> Project = { id: string }',
		'<span class="terminal__kw">async function</span> <span class="terminal__function">getProjects</span>() {',
		'  <span class="terminal__kw">return</span> db.projects.findMany();',
		'}',
		'<span class="terminal__comment">// Vista Astro con datos tipados.</span>',
		'<span class="terminal__kw">const</span> res = <span class="terminal__kw">await</span> fetch(<span class="terminal__string">\'/projects\'</span>);',
		'<span class="terminal__kw">if</span> (!response.ok) <span class="terminal__kw">throw</span> Error(<span class="terminal__string">\'failed\'</span>);',
		'<span class="terminal__kw">const</span> projects = <span class="terminal__kw">await</span> response.json();',
		'defineConfig({ output: <span class="terminal__string">\'static\'</span> });',
		'<span class="terminal__kw">return</span> Response.json({ data: projects });',
		'<span class="terminal__ok">[astro]</span> /projects · 14 ms',
		'<span class="terminal__kw">SELECT</span> id, name, status <span class="terminal__kw">FROM</span> projects;',
		'<span class="terminal__kw">WHERE</span> status = <span class="terminal__string">\'active\'</span> <span class="terminal__kw">ORDER BY</span> created_at;',
		'<span class="terminal__kw">CREATE INDEX</span> idx_status ON projects(status);',
		'<span class="terminal__dim">[query]</span> prepared · 12 rows · pooled',
		'<span class="terminal__ok">[sql]</span> committed · 3 ms · 12 rows',
		'<span class="terminal__dim">$</span> docker compose up -d --build',
		'<span class="terminal__ok">[compose]</span> web, api, db healthy',
