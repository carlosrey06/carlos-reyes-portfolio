		'<span class="terminal__kw">GET</span> /api/projects <span class="terminal__ok">200</span> · 18 ms · JSON',
		'<span class="terminal__kw">POST</span> /api/projects <span class="terminal__ok">201</span> · 26 ms · validated',
		'<span class="terminal__dim">[api]</span> response sent · 1840 bytes · cache 60 s',
		'<span class="terminal__kw">const</span> payload = { data: projects, page, pageSize, total };',
		'<span class="terminal__kw">return</span> Response.json(payload, { headers: cacheHeaders });',
		'<span class="terminal__ok">[health]</span> /health · 200 · database reachable',
		'<span class="terminal__dim">[build]</span> transforming modules · writing assets to dist/',
		'<span class="terminal__ok">[build]</span> done · 2 pages · 0 errors',
		'<span class="terminal__dim">$</span> pnpm exec astro check && pnpm build',
		'<span class="terminal__ok">[check]</span> TypeScript diagnostics: 0 · components valid',
		'<span class="terminal__warn">[deploy]</span> validating runtime environment before rollout',
