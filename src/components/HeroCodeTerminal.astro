		'<span class="terminal__ok">[astro]</span> rendered /projects · 14 ms · 8.4 kB',
		'<span class="terminal__kw">SELECT</span> id, name, status, created_at <span class="terminal__kw">FROM</span> projects;',
		'<span class="terminal__kw">WHERE</span> status = <span class="terminal__string">\'active\'</span> <span class="terminal__kw">ORDER BY</span> created_at <span class="terminal__kw">DESC</span>;',
		'<span class="terminal__kw">CREATE INDEX</span> idx_projects_status ON projects (status);',
		'<span class="terminal__dim">[query]</span> prepared statement · 12 rows · pool returned',
